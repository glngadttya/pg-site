<!DOCTYPE html>
<html lang="id" class="scroll-smooth">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title><%= title ? title + ' · ' + setup.name : setup.name %></title>
<script src="https://cdn.tailwindcss.com"></script>
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.7.2/css/all.min.css">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/atom-one-dark.min.css">
<script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Archivo+Black&family=Space+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;600&display=swap" rel="stylesheet">
<style>
:root { --ink:#111; --bg:#f6f3ea; --paper:#fffdf5; --yellow:#ffd400; --mint:#46e6a7; --pink:#ff6fbe; --blue:#4cc9f0; }
* { font-family:'Space Grotesk', system-ui, sans-serif; }
body { background:var(--bg); color:var(--ink); }
.font-display { font-family:'Archivo Black', system-ui, sans-serif; }
.brutal { border:3px solid var(--ink); border-radius:6px; box-shadow:6px 6px 0 var(--ink); }
.brutal-lg { border:4px solid var(--ink); border-radius:8px; box-shadow:8px 8px 0 var(--ink); }
.brutal-sm { border:2px solid var(--ink); border-radius:4px; box-shadow:3px 3px 0 var(--ink); }
.btn { border:3px solid var(--ink); border-radius:6px; box-shadow:4px 4px 0 var(--ink); font-weight:700; transition:all .12s ease; display:inline-block; cursor:pointer; }
.btn:hover { transform:translate(-2px,-2px); box-shadow:6px 6px 0 var(--ink); }
.btn:active { transform:translate(2px,2px); box-shadow:0 0 0 var(--ink); }
.btn-yellow { background:var(--yellow); }
.btn-ink { background:var(--ink); color:var(--paper); }
.btn-mint { background:var(--mint); }
.btn-pink { background:var(--pink); }
.btn-blue { background:var(--blue); }
.input { border:3px solid var(--ink); border-radius:6px; box-shadow:3px 3px 0 var(--ink); padding:.55rem .8rem; width:100%; background:#fff; outline:none; font-weight:600; }
.input:focus { box-shadow:5px 5px 0 var(--ink); }
.card { border:3px solid var(--ink); border-radius:8px; background:var(--paper); }
.chip { border:2px solid var(--ink); border-radius:999px; box-shadow:2px 2px 0 var(--ink); }
.tag { display:inline-block; border:2px solid var(--ink); border-radius:4px; padding:.05rem .35rem; font-size:.65rem; font-weight:700; text-transform:uppercase; letter-spacing:.04em; }
table.b-table td, table.b-table th { border:2px solid var(--ink); }
.marquee-track { display:flex; width:max-content; white-space:nowrap; animation:marquee-scroll 40s linear infinite; }
.marquee-track > span { flex:0 0 auto; }
@keyframes marquee-scroll { from { transform:translateX(0); } to { transform:translateX(-50%); } }
.term { background:#0d1117; border:3px solid var(--ink); border-radius:8px; box-shadow:5px 5px 0 var(--ink); overflow:hidden; }
.term-bar { display:flex; align-items:center; gap:6px; padding:8px 12px; background:#161b22; border-bottom:3px solid var(--ink); font-family:'JetBrains Mono',ui-monospace,monospace; font-size:12px; color:#8b949e; }
.term-dot { width:12px; height:12px; border-radius:50%; display:inline-block; }
.term-dot.red{background:#ff5f57;}
.term-dot.yellow{background:#febc2e;}
.term-dot.green{background:#28c840;}
.term-pre { margin:0; padding:14px 16px; overflow-x:auto; font-family:'JetBrains Mono',ui-monospace,monospace; font-size:13px; line-height:1.7; }
.term-pre code.hljs { background:transparent; padding:0; font-family:inherit; }
.term-pre .hljs { color:#c9d1d9; }
.term-status { display:inline-block; margin-top:8px; font-weight:700; font-size:12px; }
.icon-lg { font-size:1.35rem; }
</style>
</head>
<body class="min-h-screen flex flex-col overflow-x-hidden">