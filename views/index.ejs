<%- include('partials/head', { title: 'Home' }) %>
<%- include('partials/nav') %>

<section class="relative">
  <div class="bg-[--yellow] border-b-4 border-[--ink] py-2 overflow-hidden">
    <div class="marquee-track font-bold uppercase tracking-widest text-sm">
      <span>QRIS PAYMENT GATEWAY ✦ DEPOSIT INSTAN ✦ WITHDRAW ✦&nbsp;</span>
      <span aria-hidden="true">QRIS PAYMENT GATEWAY ✦ DEPOSIT INSTAN ✦ WITHDRAW ✦&nbsp;</span>
    </div>
  </div>

  <div class="max-w-6xl mx-auto px-4 pt-16 pb-24 grid lg:grid-cols-2 gap-12 items-center">
    <div>
      <span class="tag bg-[--mint]">Top up QRIS · instan</span>
      <h1 class="font-display text-4xl sm:text-5xl md:text-6xl leading-[0.95] mt-4">
        BAYAR PAKAI<br>QRIS <span class="text-[--pink]">JADI</span><br>GAMPANG.
      </h1>
      <p class="mt-6 text-lg font-semibold max-w-md">
        Platform pembayaran QRIS online. Deposit saldo via QRIS mendekati instan, tarik dana ke e-wallet favoritmu.
      </p>
      <div class="mt-8 flex flex-wrap gap-4">
        <% if (user) { %>
          <a href="/dashboard" class="btn btn-yellow px-6 py-3 text-lg"><i class="fa-solid fa-gauge-high mr-2"></i>Dashboard</a>
        <% } else { %>
          <a href="/auth" class="btn btn-yellow px-6 py-3 text-lg"><i class="fa-solid fa-right-to-bracket mr-2"></i>Masuk Sekarang</a>
        <% } %>
        <a href="/docs" class="btn px-6 py-3 text-lg" style="background:#fff"><i class="fa-solid fa-book mr-2"></i>Lihat Docs API</a>
      </div>
      <div class="mt-10 flex flex-wrap gap-x-8 gap-y-4 font-display text-lg">
        <div><i class="fa-solid fa-wallet text-2xl text-[--pink] mr-2 align-middle"></i><span class="text-[--pink]">3</span> Metode<br>E-Wallet</div>
        <div><i class="fa-solid fa-bolt text-2xl text-[--mint] mr-2 align-middle"></i>Deposit<br>Instan</div>
        <div><i class="fa-solid fa-bell text-2xl text-[--blue] mr-2 align-middle"></i>24/7<br>Service</div>
      </div>
    </div>

    <div class="relative">
      <div class="card brutal-lg bg-[--blue] p-6 rotate-2">
        <div class="bg-[--paper] brutal p-4">
          <div class="flex items-center justify-between">
            <span class="font-display">VANPAY</span>
            <span class="tag bg-[--mint]">QRIS</span>
          </div>
          <div class="mt-4 aspect-square max-w-[260px] mx-auto bg-white brutal p-2 grid place-items-center">
            <img src="https://api.qrserver.com/v1/create-qr-code/?size=220x220&data=vanpay-qris" alt="QRIS" class="w-full">
          </div>
          <div class="mt-4 flex justify-between items-center">
            <span class="font-bold">Saldo</span>
            <span class="font-display text-2xl">Rp10.000</span>
          </div>
        </div>
        <div class="flex justify-between gap-3 mt-4">
          <div class="flex-1 bg-[--paper] brutal-sm p-3 text-center font-bold">DANA</div>
          <div class="flex-1 bg-[--paper] brutal-sm p-3 text-center font-bold">GOPAY</div>
          <div class="flex-1 bg-[--paper] brutal-sm p-3 text-center font-bold">SHOPEE PAY</div>
        </div>
      </div>
      <div class="absolute -bottom-6 -left-4 bg-[--pink] brutal px-4 py-2 font-display -rotate-3">NEARLY INSTANT ✦</div>
    </div>
  </div>
</section>

<section class="border-t-4 border-[--ink] bg-[--paper]">
  <div class="max-w-6xl mx-auto px-4 py-16">
    <h2 class="font-display text-4xl">CARA KERJA</h2>
    <div class="mt-8 grid md:grid-cols-3 gap-6">
      <div class="card brutal p-6 bg-[--yellow]">
        <div class="flex items-center gap-3">
          <span class="font-display text-5xl">01</span>
          <i class="fa-solid fa-qrcode text-3xl"></i>
        </div>
        <h3 class="font-display text-xl mt-3">Login & Deposit</h3>
        <p class="mt-2 font-semibold">Login pakai akun Google atau GitHub, lalu pilih nominal top up. QRIS langsung muncul untuk kamu scan & bayar.</p>
      </div>
      <div class="card brutal p-6 bg-[--mint]">
        <div class="flex items-center gap-3">
          <span class="font-display text-5xl">02</span>
          <i class="fa-solid fa-bolt text-3xl"></i>
        </div>
        <h3 class="font-display text-xl mt-3">Saldo Masuk Otomatis</h3>
        <p class="mt-2 font-semibold">Begitu pembayaran terdeteksi, saldo langsung masuk ke akun.</p>
      </div>
      <div class="card brutal p-6 bg-[--pink]">
        <div class="flex items-center gap-3">
          <span class="font-display text-5xl">03</span>
          <i class="fa-solid fa-money-bill-transfer text-3xl"></i>
        </div>
        <h3 class="font-display text-xl mt-3">Tarik Dana / Integrasi</h3>
        <p class="mt-2 font-semibold">Tarik ke DANA, GoPay, atau ShopeePay, atau pakai API untuk kebutuhan website atau bot kamu.</p>
      </div>
    </div>
  </div>
</section>

<footer class="border-t-4 border-[--ink] bg-[--paper]">
  <div class="max-w-6xl mx-auto px-4 py-6 text-center">
    <span class="font-semibold text-sm">© <%= new Date().getFullYear() %> <%= setup.name %> — QRIS Payment Gateway</span>
  </div>
</footer>

<%- include('partials/foot') %>