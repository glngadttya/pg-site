<%- include('../partials/head', { title: 'Admin Penarikan' }) %>
<%- include('../partials/nav') %>

<div class="max-w-6xl mx-auto px-4 py-10 w-full">
  <span class="tag bg-[--pink]">Owner Panel</span>
  <h1 class="font-display text-4xl mt-2">Penarikan Dana</h1>
  <p class="mt-2 font-semibold">Proses penarikan user secara manual ke e-wallet. Jika ditolak, saldo user dikembalikan.</p>

  <% if (msg) { %><div class="mt-4 bg-[--mint] brutal-sm p-3 font-semibold text-sm"><%= msg %></div><% } %>
  <% if (err) { %><div class="mt-4 bg-[--pink] brutal-sm p-3 font-semibold text-sm text-[--ink]"><%= err %></div><% } %>

  <div class="mt-6 flex gap-3 flex-wrap">
    <a href="/admin/withdraw?filter=all" class="btn px-4 py-2 <%= filter === 'all' ? 'btn-ink text-[--paper]' : '' %>" style="<%= filter === 'all' ? '' : 'background:#fff' %>">Semua</a>
    <a href="/admin/withdraw?filter=pending" class="btn px-4 py-2 <%= filter === 'pending' ? 'btn-ink text-[--paper]' : '' %>" style="<%= filter === 'pending' ? '' : 'background:#fff' %>">Pending</a>
    <a href="/admin/withdraw?filter=approved" class="btn px-4 py-2 <%= filter === 'approved' ? 'btn-ink text-[--paper]' : '' %>" style="<%= filter === 'approved' ? '' : 'background:#fff' %>">Approved</a>
    <a href="/admin/withdraw?filter=rejected" class="btn px-4 py-2 <%= filter === 'rejected' ? 'btn-ink text-[--paper]' : '' %>" style="<%= filter === 'rejected' ? '' : 'background:#fff' %>">Rejected</a>
  </div>

  <div class="card brutal-lg mt-6 overflow-x-auto">
    <table class="w-full b-table text-left text-sm min-w-[900px]">
      <thead class="bg-[--yellow]">
        <tr>
          <th class="p-3">ID</th>
          <th class="p-3">User</th>
          <th class="p-3">Metode</th>
          <th class="p-3">Rekening</th>
          <th class="p-3">Jumlah</th>
          <th class="p-3">Fee</th>
          <th class="p-3">Status</th>
          <th class="p-3">Aksi</th>
        </tr>
      </thead>
      <tbody class="bg-[--paper]">
        <% if (rows.length === 0) { %>
          <tr><td colspan="8" class="p-6 text-center font-semibold">Tidak ada data.</td></tr>
        <% } else { %>
          <% rows.forEach(function (w) { %>
          <tr>
            <td class="p-3 font-mono text-xs"><%= w.id %></td>
            <td class="p-3 font-bold"><%= w.user.username || '-' %></td>
            <td class="p-3 uppercase font-bold"><%= w.method %></td>
            <td class="p-3">
              <div class="font-bold"><%= w.account %></div>
              <div class="text-xs font-semibold opacity-60"><%= w.holder %></div>
            </td>
            <td class="p-3 font-bold"><%= helpers.rupiah(w.amount) %></td>
            <td class="p-3 font-semibold"><%= helpers.rupiah(w.fee) %></td>
            <td class="p-3"><span class="tag <%= w.status === 'approved' ? 'bg-[--mint]' : w.status === 'pending' ? 'bg-[--yellow]' : 'bg-[--pink]' %>"><%= w.status %></span></td>
            <td class="p-3">
              <% if (w.status === 'pending') { %>
                <div class="flex gap-2">
                  <form method="POST" action="/admin/withdraw/<%= w.id %>/approve" onsubmit="return confirm('Tandai sebagai sudah dikirim?');">
                    <button class="btn btn-mint px-3 py-1 text-xs">Setujui</button>
                  </form>
                  <form method="POST" action="/admin/withdraw/<%= w.id %>/reject" onsubmit="return confirm('Tolak dan kembalikan saldo user?');">
                    <button class="btn btn-pink px-3 py-1 text-xs">Tolak</button>
                  </form>
                </div>
              <% } else { %>—<% } %>
            </td>
          </tr>
          <% }) %>
        <% } %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/foot') %>