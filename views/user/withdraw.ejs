<%- include('../partials/head', { title: 'Tarik Dana' }) %>
<%- include('../partials/nav') %>

<div class="max-w-2xl mx-auto px-4 py-10 w-full">
  <span class="tag bg-[--pink]"><i class="fa-solid fa-money-bill-transfer mr-1"></i>Minimal Rp5.000</span>
  <h1 class="font-display text-4xl mt-2">Tarik Dana</h1>
  <p class="mt-2 font-semibold">Saldo kamu <b><%= helpers.rupiah(user.balance) %></b>. Biaya layanan dihitung otomatis dari nominal penarikan.</p>

  <% if (msg) { %><div class="mt-4 bg-[--mint] brutal-sm p-3 font-semibold text-sm"><%= msg %></div><% } %>
  <% if (err) { %><div class="mt-4 bg-[--pink] brutal-sm p-3 font-semibold text-sm text-[--ink]"><%= err %></div><% } %>

  <form id="withdraw-form" method="POST" action="/withdraw" class="card brutal-lg mt-6 p-6 space-y-4">
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-wallet mr-1"></i>E-Wallet Tujuan</label>
      <select name="method" required class="input mt-1">
        <option value="">— pilih e-wallet —</option>
        <option value="dana">DANA</option>
        <option value="gopay">GoPay</option>
        <option value="shopeepay">ShopeePay</option>
      </select>
    </div>
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-hashtag mr-1"></i>Nomor Akun E-Wallet</label>
      <input name="account" type="text" inputmode="numeric" required minlength="4" class="input mt-1" placeholder="0838xxxxx">
    </div>
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-user mr-1"></i>Nama Pemilik Akun</label>
      <input name="holder" type="text" required class="input mt-1" placeholder="Nama sesuai rekening">
    </div>
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-coins mr-1"></i>Jumlah Penarikan</label>
      <div class="input mt-1 flex items-center gap-2">
        <span class="font-display">Rp</span>
        <input name="amount" type="number" min="5000" step="1000" required class="bg-transparent font-bold outline-none w-full" placeholder="100000">
      </div>
      <div>
        <label class="font-bold text-sm mt-3 block" for="fee-input"><i class="fa-solid fa-scissors mr-1"></i>Fee Penarikan</label>
        <div class="input mt-1 flex items-center gap-2 bg-[--paper]">
          <span class="font-display">Rp</span>
          <input id="fee-input" type="text" readonly class="bg-transparent font-bold outline-none w-full" placeholder="Otomatis sesuai nominal" value="">
        </div>
      </div>
      <details class="mt-3 text-xs">
        <summary class="font-bold cursor-pointer opacity-70"><i class="fa-solid fa-table mr-1"></i>Tabel biaya layanan</summary>
        <table class="b-table w-full mt-2 text-left">
          <thead><tr><th class="p-2">Nominal</th><th class="p-2">Biaya</th></tr></thead>
          <tbody>
            <% feeTiers.forEach((t) => { %>
              <tr><td class="p-2 font-semibold"><%= t.label %></td><td class="p-2 font-semibold">Rp<%= t.fee.toLocaleString('id-ID') %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </details>
    </div>
    <button class="btn btn-pink px-6 py-3">Kirim Permintaan Penarikan</button>
  </form>
</div>

<div id="wd-modal" class="modal-overlay hidden">
  <div class="modal-card">
    <div id="wd-badge" class="badge-ok"><div class="badge-circle">
      <svg class="badge-svg" viewBox="0 0 48 48"><path class="badge-check" d="M16 24 L22 30 L33 18"/><path class="badge-x" d="M17 17 L31 31 M31 17 L17 31"/></svg>
    </div></div>
    <div id="wd-title" class="font-display text-xl mt-4">Permintaan penarikan terkirim</div>
    <p id="wd-sub" class="mt-2 text-sm font-semibold">Menunggu persetujuan admin.</p>
    <button class="btn btn-yellow px-6 py-2.5 mt-6" onclick="location.href='/dashboard'">Kembali</button>
  </div>
</div>

<script>
  const TIERS = <%= JSON.stringify(feeTiers) %>;
  function fmt(n) { return 'Rp' + Number(n || 0).toLocaleString('id-ID'); }
  function getFee(n) {
    n = parseInt(n, 10) || 0;
    const t = TIERS.find((x) => n >= x.min && n <= x.max);
    return t ? t.fee : 0;
  }
  var amountInput = document.querySelector('[name=amount]');
  var feeInput = document.getElementById('fee-input');
  amountInput.addEventListener('input', function (e) {
    const amt = parseInt(e.target.value, 10) || 0;
    feeInput.value = amt ? fmt(getFee(amt)) : '';
  });

  (function () {
    var form = document.getElementById('withdraw-form');
    var modal = document.getElementById('wd-modal');
    var badge = document.getElementById('wd-badge');
    var title = document.getElementById('wd-title');
    var sub = document.getElementById('wd-sub');
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type=submit], button');
      var old = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i>Mengirim...';
      try {
        var r = await fetch('/withdraw', { method: 'POST', headers: { 'Accept': 'application/json', 'Content-Type': 'application/x-www-form-urlencoded' }, body: new URLSearchParams(new FormData(form)).toString() });
        var d = await r.json();
        if (d.success) {
          badge.className = 'badge-ok';
          title.textContent = 'Permintaan penarikan terkirim';
          sub.textContent = 'Menunggu persetujuan admin.';
        } else {
          badge.className = 'badge-err';
          title.textContent = 'Gagal mengirim penarikan';
          sub.textContent = d.message || 'Terjadi kesalahan, coba lagi.';
        }
        modal.classList.remove('hidden');
      } catch (e) {
        badge.className = 'badge-err';
        title.textContent = 'Gagal mengirim penarikan';
        sub.textContent = 'Terjadi kesalahan jaringan, coba lagi.';
        modal.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.innerHTML = old;
      }
    });
  })();
</script>

<%- include('../partials/foot') %>