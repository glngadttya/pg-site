<%- include('../partials/head', { title: 'Tarik Dana' }) %>
<%- include('../partials/nav') %>

<div class="max-w-2xl mx-auto px-4 py-10 w-full">
  <span class="tag bg-[--pink]"><i class="fa-solid fa-money-bill-transfer mr-1"></i>Minimal Rp5.000</span>
  <h1 class="font-display text-4xl mt-2">Tarik Dana</h1>
  <p class="mt-2 font-semibold">Saldo kamu <b><%= helpers.rupiah(user.balance) %></b>. Biaya layanan dihitung otomatis dari nominal penarikan.</p>

  <% if (msg) { %><div class="mt-4 bg-[--mint] brutal-sm p-3 font-semibold text-sm"><%= msg %></div><% } %>
  <% if (err) { %><div class="mt-4 bg-[--pink] brutal-sm p-3 font-semibold text-sm text-[--ink]"><%= err %></div><% } %>

  <form method="POST" action="/withdraw" class="card brutal-lg mt-6 p-6 space-y-4">
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-wallet mr-1"></i>E-Wallet Tujuan</label>
      <select name="method" required class="input mt-1">
        <option value="">— pilih e-wallet —</option>
        <option value="dana">DANA</option>
        <option value="gopay">GoPay</option>
        <option value="shopeepay">ShopeePay</option>
      </select>
    </div>
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-hashtag mr-1"></i>Nomor Akun E-Wallet</label>
      <input name="account" type="text" inputmode="numeric" required minlength="4" class="input mt-1" placeholder="0838xxxxx">
    </div>
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-user mr-1"></i>Nama Pemilik Akun</label>
      <input name="holder" type="text" required class="input mt-1" placeholder="Nama sesuai rekening">
    </div>
    <div>
      <label class="font-bold text-sm"><i class="fa-solid fa-coins mr-1"></i>Jumlah Penarikan</label>
      <div class="input mt-1 flex items-center gap-2">
        <span class="font-display">Rp</span>
        <input name="amount" type="number" min="5000" step="1000" required class="bg-transparent font-bold outline-none w-full" placeholder="100000">
      </div>
      <div class="mt-2 text-xs font-semibold opacity-70">
        Biaya layanan: <b id="fee-display" class="opacity-100">Rp0</b> — Total terpotong: <b id="total-display" class="opacity-100">Rp0</b>
      </div>
      <details class="mt-3 text-xs">
        <summary class="font-bold cursor-pointer opacity-70"><i class="fa-solid fa-table mr-1"></i>Tabel biaya layanan</summary>
        <table class="b-table w-full mt-2 text-left">
          <thead><tr><th class="p-2">Nominal</th><th class="p-2">Biaya</th></tr></thead>
          <tbody>
            <% feeTiers.forEach((t) => { %>
              <tr><td class="p-2 font-semibold"><%= t.label %></td><td class="p-2 font-semibold">Rp<%= t.fee.toLocaleString('id-ID') %></td></tr>
            <% }) %>
          </tbody>
        </table>
      </details>
    </div>
    <button class="btn btn-pink px-6 py-3">Kirim Permintaan Penarikan</button>
  </form>
</div>

<script>
  const TIERS = <%= JSON.stringify(feeTiers) %>;
  function fmt(n) { return 'Rp' + Number(n || 0).toLocaleString('id-ID'); }
  function getFee(n) {
    n = parseInt(n, 10) || 0;
    const t = TIERS.find((x) => n >= x.min && n <= x.max);
    return t ? t.fee : 0;
  }
  document.querySelector('[name=amount]').addEventListener('input', function (e) {
    const amt = parseInt(e.target.value, 10) || 0;
    const fee = getFee(amt);
    document.getElementById('fee-display').textContent = fmt(fee);
    document.getElementById('total-display').textContent = fmt(amt + fee);
  });
</script>

<%- include('../partials/foot') %>