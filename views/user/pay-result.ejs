<%- include('../partials/head', { title: 'Pembayaran' }) %>
<%- include('../partials/nav') %>

<div class="max-w-xl mx-auto px-4 py-12 w-full">
  <% if (!payment) { %>
    <div class="card brutal-lg p-8 text-center bg-[--pink]">
      <div class="font-display text-3xl">Pembayaran Tidak Ditemukan</div>
      <p class="mt-3 font-semibold">Link pembayaran tidak valid atau sudah kedaluwarsa.</p>
      <a href="/" class="btn btn-yellow px-5 py-2.5 mt-6">Kembali ke Beranda</a>
    </div>
  <% } else { %>
  <span class="tag bg-[--blue]"><i class="fa-solid fa-barcode mr-1"></i>Payment ID: <%= payment.id %></span>
  <h1 class="font-display text-4xl mt-3">Scan & Bayar</h1>
  <p class="mt-2 font-semibold"><i class="fa-solid fa-qrcode text-[--pink] mr-1"></i>Gunakan aplikasi e-wallet atau m-banking yang mendukung QRIS untuk melakukan pembayaran.</p>

  <div class="card brutal-lg mt-6 p-6 text-center bg-[--yellow]">
    <div class="font-bold uppercase tracking-wide">Total Pembayaran</div>
    <div class="font-display text-5xl mt-1"><%= helpers.rupiah(payment.amount) %></div>

    <div id="qr-box" class="mt-6 bg-white brutal-lg inline-block p-3">
      <img src="<%= payment.qr_url %>" alt="QRIS" class="w-56 h-56 object-contain">
    </div>
    <div class="mt-3 text-sm font-semibold">Scan QRIS di atas untuk membayar</div>

    <div class="mt-5 grid grid-cols-1 sm:grid-cols-2 gap-3 text-left">
      <div class="bg-[--paper] brutal-sm p-3">
        <div class="text-xs font-bold opacity-60"><i class="fa-solid fa-circle-info mr-1"></i>Status</div>
        <div id="status" class="font-bold text-sm capitalize mt-1"><%= payment.status %></div>
      </div>
      <div class="bg-[--paper] brutal-sm p-3">
        <div class="text-xs font-bold opacity-60"><i class="fa-solid fa-hourglass-half mr-1"></i>Kadaluarsa</div>
        <div class="mt-1">
          <div id="countdown" class="countdown font-bold text-base">--:--</div>
          <div class="text-xs font-bold opacity-70 countdown">Asia/Jakarta · <span id="clock-wib">--:--:--</span></div>
        </div>
      </div>
    </div>
  </div>

  <div id="paid-modal" class="modal-overlay hidden">
    <div class="modal-card">
      <div class="badge-ok"><div class="badge-circle">
        <svg class="badge-svg" viewBox="0 0 48 48"><circle cx="24" cy="24" r="19"/><path d="M16 24 L22 30 L33 18"/></svg>
      </div></div>
      <div class="font-display text-xl mt-4">Pembayaran telah berhasil</div>
      <p class="mt-2 text-sm font-semibold">Saldo kamu sudah bertambah. Terima kasih!</p>
      <button class="btn btn-yellow px-6 py-2.5 mt-6" onclick="location.href='/dashboard'">Kembali</button>
    </div>
  </div>

  <% if (payment.status === 'pending') { %>
  <script>
    var payId = '<%= payment.id %>';
    var expAt = new Date('<%= payment.exp_at %>').getTime();
    var statusEl = document.getElementById('status');
    var countEl = document.getElementById('countdown');
    var clockEl = document.getElementById('clock-wib');
    var paidModal = document.getElementById('paid-modal');
    var qrBox = document.getElementById('qr-box');
    var done = false;

    function pad(n) { return String(n).padStart(2, '0'); }
    function wibTime(d) {
      try { return d.toLocaleTimeString('id-ID', { timeZone: 'Asia/Jakarta', hour: '2-digit', minute: '2-digit', second: '2-digit' }); }
      catch (e) { return d.toTimeString().slice(0, 8); }
    }
    function tick() {
      var now = Date.now();
      var rem = expAt - now;
      if (rem <= 0) {
        countEl.textContent = '00:00';
        statusEl.textContent = 'expired';
        qrBox.classList.add('opacity-20');
        clearInterval(timer);
        return;
      }
      var s = Math.floor(rem / 1000);
      countEl.textContent = pad(Math.floor(s / 60)) + ':' + pad(s % 60);
      clockEl.textContent = wibTime(new Date());
    }
    var timer = setInterval(tick, 1000);
    tick();

    setInterval(function () {
      if (done) return;
      fetch('/payment/status?id=' + payId).then(function (r) { return r.json(); }).then(function (d) {
        if (!d.success) return;
        statusEl.textContent = d.status;
        if (d.status === 'paid') {
          done = true;
          clearInterval(timer);
          qrBox.classList.add('opacity-20');
          paidModal.classList.remove('hidden');
        } else if (d.status === 'expired') {
          clearInterval(timer);
          countEl.textContent = '00:00';
          qrBox.classList.add('opacity-20');
        }
      }).catch(function () {});
    }, 3000);
  </script>
  <% } %>
  <% } %>
</div>

<%- include('../partials/foot') %>