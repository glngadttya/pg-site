<%- include('../partials/head', { title: 'Dashboard' }) %>
<%- include('../partials/nav') %>

<div class="max-w-6xl mx-auto px-4 py-10 w-full">
  <div class="flex flex-wrap items-end justify-between gap-4">
    <div>
      <span class="tag bg-[--mint]">Halo, <%= user.username %></span>
      <h1 class="font-display text-4xl mt-2">Dashboard</h1>
    </div>
    <a href="/history" class="btn px-4 py-2" style="background:#fff">Lihat Riwayat →</a>
  </div>

  <div class="mt-8 grid md:grid-cols-3 gap-6">
    <div class="card brutal-lg bg-[--yellow] p-6">
      <div class="flex items-center gap-2 font-bold uppercase text-sm tracking-wide"><i class="fa-solid fa-wallet"></i>Saldo</div>
      <div class="font-display text-4xl mt-2"><%= helpers.rupiah(user.balance) %></div>
      <div class="mt-3 text-sm font-semibold">Siap dipakai untuk permintaan pembayaran & penarikan.</div>
    </div>
    <div class="card brutal-lg bg-[--mint] p-6">
      <div class="flex items-center gap-2 font-bold uppercase text-sm tracking-wide"><i class="fa-solid fa-arrow-down-to-bracket"></i>Total Deposit</div>
      <div class="font-display text-4xl mt-2"><%= helpers.rupiah(totalDeposit) %></div>
      <div class="mt-3 text-sm font-semibold"><%= countDeposit %>× transaksi masuk</div>
    </div>
    <div class="card brutal-lg bg-[--pink] p-6">
      <div class="flex items-center gap-2 font-bold uppercase text-sm tracking-wide"><i class="fa-solid fa-arrow-up-from-bracket"></i>Total Tarik</div>
      <div class="font-display text-4xl mt-2"><%= helpers.rupiah(totalWithdraw) %></div>
      <div class="mt-3 text-sm font-semibold"><%= countWithdraw %>× penarikan</div>
    </div>
  </div>

  <div class="mt-8 grid lg:grid-cols-2 gap-6">
    <div class="card brutal p-6">
      <h2 class="font-display text-2xl"><i class="fa-solid fa-circle-plus text-[--mint] mr-2"></i>Top Up Saldo</h2>
      <p class="mt-1 font-semibold text-sm">Scan QRIS yang dibuat & bayar. Saldo masuk otomatis mendekati instan.</p>
      <% if (msg) { %>
        <div class="mt-4 bg-[--mint] brutal-sm p-3 font-semibold text-sm"><%= msg %></div>
      <% } %>
      <% if (err) { %>
        <div class="mt-4 bg-[--pink] brutal-sm p-3 font-semibold text-sm text-[--ink]"><%= err %></div>
      <% } %>
      <form id="deposit-form" method="POST" action="/dashboard/deposit" class="mt-5 space-y-4">
        <div>
          <label class="font-bold text-sm">Nominal (maks Rp5.000.000)</label>
          <div class="input mt-1 flex items-center gap-2">
            <span class="font-display">Rp</span>
            <input name="amount" type="number" min="1000" max="5000000" step="1000" required class="bg-transparent font-bold outline-none w-full" placeholder="50000">
          </div>
        </div>
        <button class="btn btn-yellow px-5 py-3 font-bold">Buat QRIS Pembayaran</button>
      </form>
    </div>

    <div class="card brutal p-6">
      <h2 class="font-display text-2xl"><i class="fa-solid fa-clock-rotate-left text-[--blue] mr-2"></i>Transaksi Terakhir</h2>
      <div class="mt-4 space-y-3">
        <% if (recent.length === 0) { %>
          <div class="bg-[--paper] brutal-sm p-4 font-semibold text-sm">Belum ada transaksi. Mulai top up sekarang!</div>
        <% } else { %>
          <% recent.forEach(function (t) { %>
            <% var isDeposit = t.type === 'deposit'; %>
            <div class="flex items-center justify-between bg-[--paper] brutal-sm p-3">
              <div>
                <div class="font-bold text-sm capitalize"><%= isDeposit ? 'Deposit' : 'Tarik Dana · ' + t.method %></div>
                <div class="text-xs font-semibold opacity-60"><%= new Date(t.created_at).toLocaleString('id-ID') %></div>
              </div>
              <div class="text-right">
                <div class="font-display"><%= isDeposit ? '+' : '−' %><%= helpers.rupiah(t.amount) %></div>
                <span class="tag <%= t.status === 'paid' || t.status === 'approved' ? 'bg-[--mint]' : t.status === 'pending' ? 'bg-[--yellow]' : 'bg-[--pink]' %>"><%= t.status %></span>
              </div>
            </div>
          <% }) %>
        <% } %>
      </div>
      <a href="/history" class="btn px-4 py-2 mt-5" style="background:#fff">Semua Riwayat →</a>
    </div>
  </div>
</div>

<div id="deposit-modal" class="modal-overlay hidden">
  <div class="modal-card">
    <div id="deposit-badge" class="badge-ok"><div class="badge-circle">
      <svg class="badge-svg" viewBox="0 0 48 48"><circle cx="24" cy="24" r="19"/><path d="M16 24 L22 30 L33 18"/></svg>
    </div></div>
    <div id="deposit-title" class="font-display text-xl mt-4">Berhasil membuat QRIS pembayaran</div>
    <p id="deposit-sub" class="mt-2 text-sm font-semibold">Klik Lanjut untuk membuka halaman pembayaran.</p>
    <button id="deposit-ok" class="btn btn-yellow px-6 py-2.5 mt-6">Lanjut</button>
  </div>
</div>

<script>
  (function () {
    var form = document.getElementById('deposit-form');
    var modal = document.getElementById('deposit-modal');
    var badge = document.getElementById('deposit-badge');
    var title = document.getElementById('deposit-title');
    var sub = document.getElementById('deposit-sub');
    var okBtn = document.getElementById('deposit-ok');
    var pendingId = null;
    form.addEventListener('submit', async function (e) {
      e.preventDefault();
      var btn = form.querySelector('button[type=submit], button');
      var old = btn.innerHTML;
      btn.disabled = true;
      btn.innerHTML = '<i class="fa-solid fa-spinner fa-spin mr-1"></i>Membuat...';
      try {
        var r = await fetch('/dashboard/deposit', { method: 'POST', headers: { 'Accept': 'application/json' }, body: new FormData(form) });
        var d = await r.json();
        if (d.success) {
          pendingId = d.id;
          badge.className = 'badge-ok';
          title.textContent = 'Berhasil membuat QRIS pembayaran';
          sub.textContent = 'Klik Lanjut untuk membuka halaman pembayaran.';
          okBtn.classList.remove('btn-pink');
          okBtn.classList.add('btn-yellow');
          okBtn.innerHTML = 'Lanjut';
          okBtn.onclick = function () { location.href = '/payment?id=' + pendingId; };
        } else {
          badge.className = 'badge-err';
          title.textContent = 'Gagal membuat QRIS';
          sub.textContent = d.message || 'Terjadi kesalahan, coba lagi.';
          okBtn.classList.remove('btn-yellow');
          okBtn.classList.add('btn-pink');
          okBtn.innerHTML = 'Tutup';
          okBtn.onclick = function () { modal.classList.add('hidden'); };
        }
        modal.classList.remove('hidden');
      } catch (e) {
        badge.className = 'badge-err';
        title.textContent = 'Gagal membuat QRIS';
        sub.textContent = 'Terjadi kesalahan jaringan, coba lagi.';
        okBtn.classList.remove('btn-yellow');
        okBtn.classList.add('btn-pink');
        okBtn.innerHTML = 'Tutup';
        okBtn.onclick = function () { modal.classList.add('hidden'); };
        modal.classList.remove('hidden');
      } finally {
        btn.disabled = false;
        btn.innerHTML = old;
      }
    });
  })();
</script>

<%- include('../partials/foot') %>